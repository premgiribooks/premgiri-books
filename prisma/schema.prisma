// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Shared Field Convention (documentation only — not yet applied to every model)
//
// Every future business model (Customer, Product, Voucher, etc.) should follow
// this convention:
//
// Required
//   id         String   @id @default(uuid())
//   createdAt  DateTime @default(now())
//   updatedAt  DateTime @updatedAt
//
// Optional (add when the model needs them)
//   createdBy  String?
//   updatedBy  String?
//   deletedAt  DateTime?
//   remarks    String?
//
// The foundation models below only implement the required fields; optional
// audit/soft-delete fields are documented here for later phases to reuse.
// -----------------------------------------------------------------------------

model Company {
  id               String   @id @default(uuid())
  companyName      String
  legalName        String
  displayName      String?
  businessType     String?
  gstin            String?  @unique
  pan              String?
  tan              String?
  cin              String?
  mobileNumber     String?
  alternateMobile  String?
  email            String?
  website          String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  // The company's own GST state code (01-38, GST_STATE_CODES) — needed by
  // the GST Engine's determineSupplyType() to decide intra- vs inter-state
  // tax on every GST-taxed document (first consumer: Quotation, feature-spec
  // 35; also needed by Purchase Order, feature-spec 42). Deliberately a real,
  // explicit column rather than derived from `gstin`'s prefix or a fuzzy
  // match against the free-text `state` name — an existing company's
  // stateCode is null until a Company Admin sets it via Company Profile; the
  // first document-creating call blocks with a friendly error until it is
  // set, never guesses.
  stateCode        String?
  district         String?
  country          String   @default("India")
  pinCode          String?
  currency         String   @default("INR")
  currencySymbol   String   @default("₹")
  decimalPlaces    Int      @default(2)
  logo             String?
  timeZone         String   @default("Asia/Kolkata")
  isActive         Boolean  @default(true)
  // Lets a future ERP upgrade detect a company seeded by an older
  // TenantBootstrapService version (missing a newer default role/permission/
  // master) without a manual migration. Only the column exists today — no
  // detect-and-backfill logic reads it yet; see
  // architecture-Migration-Super-Admin-Administration-Implementation-Plan.md.
  bootstrapVersion Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  settings          CompanySettings?
  financialYears    FinancialYear[]
  branches          Branch[]
  users             User[]
  roles             Role[]
  ledgerGroups      LedgerGroup[]
  ledgers           Ledger[]
  bankAccounts      BankAccount[]
  units             Unit[]
  categories        Category[]
  brands            Brand[]
  hsnCodes          HsnCode[]
  gstRates          GstRate[]
  warehouses        Warehouse[]
  products          Product[]
  marginProfiles    MarginProfile[]
  priceLists        PriceList[]
  customers         Customer[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  purchaseInvoices  PurchaseInvoice[]
  auditLogs         AuditLog[]
  documentSequences DocumentSequence[]
  vouchers          Voucher[]
  stockTransactions StockTransaction[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  deliveryChallans  DeliveryChallan[]
  salesInvoices     SalesInvoice[]
  salesReturns      SalesReturn[]
  creditNotes       CreditNote[]
  debitNotes        DebitNote[]

  @@index([companyName])
}

model CompanySettings {
  id                 String   @id @default(uuid())
  companyId          String   @unique
  defaultTheme       String   @default("dark")
  dateFormat         String   @default("DD/MM/YYYY")
  timeFormat         String   @default("24h")
  numberFormat       String   @default("en-IN")
  currencyFormat     String   @default("INR")
  // Inventory Engine's negative-stock gate (32-inventory-engine.md;
  // code-standards.md "Negative stock depends on company settings") — when
  // false (default), an OUT movement that would take current stock below
  // zero is rejected; when true, it is allowed and stock reads back
  // negative.
  allowNegativeStock Boolean  @default(false)
  // Sales Invoice's posting-time ledger mapping (38-sales-invoice.md) — six
  // optional nullable FKs rather than auto-detection ("explicit over
  // clever," this codebase's posture since the Document Number Engine's
  // prefix map). Posting a Sales Invoice requires all six configured;
  // drafting/editing does not. outputIgstLedgerId/outputCessLedgerId stay
  // required even for an intra-state-only company for the same reason.
  salesLedgerId      String?
  salesLedger        Ledger?  @relation("CompanySettingsSalesLedger", fields: [salesLedgerId], references: [id])
  outputCgstLedgerId String?
  outputCgstLedger   Ledger?  @relation("CompanySettingsOutputCgst", fields: [outputCgstLedgerId], references: [id])
  outputSgstLedgerId String?
  outputSgstLedger   Ledger?  @relation("CompanySettingsOutputSgst", fields: [outputSgstLedgerId], references: [id])
  outputIgstLedgerId String?
  outputIgstLedger   Ledger?  @relation("CompanySettingsOutputIgst", fields: [outputIgstLedgerId], references: [id])
  outputCessLedgerId String?
  outputCessLedger   Ledger?  @relation("CompanySettingsOutputCess", fields: [outputCessLedgerId], references: [id])
  roundOffLedgerId   String?
  roundOffLedger     Ledger?  @relation("CompanySettingsRoundOff", fields: [roundOffLedgerId], references: [id])
  // Purchase Invoice's posting-time ledger mapping (44-purchase-invoice.md) —
  // five new fields alongside the Sales/Output-GST mapping above, reusing
  // roundOffLedgerId rather than adding a second Round Off account (one
  // Round Off ledger serves both directions). Posting a Purchase Invoice
  // requires these five plus the shared roundOffLedgerId (six total) to be
  // configured — same missing-mapping rejection style as Sales Invoice.
  purchaseLedgerId   String?
  purchaseLedger     Ledger?  @relation("CompanySettingsPurchaseLedger", fields: [purchaseLedgerId], references: [id])
  inputCgstLedgerId  String?
  inputCgstLedger    Ledger?  @relation("CompanySettingsInputCgst", fields: [inputCgstLedgerId], references: [id])
  inputSgstLedgerId  String?
  inputSgstLedger    Ledger?  @relation("CompanySettingsInputSgst", fields: [inputSgstLedgerId], references: [id])
  inputIgstLedgerId  String?
  inputIgstLedger    Ledger?  @relation("CompanySettingsInputIgst", fields: [inputIgstLedgerId], references: [id])
  inputCessLedgerId  String?
  inputCessLedger    Ledger?  @relation("CompanySettingsInputCess", fields: [inputCessLedgerId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

model FinancialYear {
  id        String   @id @default(uuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  documentSequences DocumentSequence[]
  vouchers          Voucher[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  deliveryChallans  DeliveryChallan[]
  salesInvoices     SalesInvoice[]
  salesReturns      SalesReturn[]
  creditNotes       CreditNote[]
  debitNotes        DebitNote[]
  purchaseOrders    PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  purchaseInvoices  PurchaseInvoice[]

  @@unique([companyId, name])
  @@index([companyId, isCurrent])
}

model Branch {
  id              String   @id @default(uuid())
  companyId       String
  branchName      String
  branchCode      String
  address         String?
  contactNumber   String?
  gstRegistration String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[]

  // Referenced by Warehouse's composite tenant-safe FK (companyId, branchId)
  // → (companyId, id); Postgres requires a unique constraint covering the
  // referenced column pair. Redundant with id's PK for lookups, load-bearing
  // for the FK.
  @@unique([companyId, id])
  @@unique([companyId, branchCode])
}

// context/feature-specs/architecture-Migration-Super-Admin-Administration.md
// (implementation detail recorded in the matching
// -Implementation-Plan.md) introduces a PLATFORM vs COMPANY split (Super
// Admin vs Company Admin/Company Users) on top of the prior single-
// Administrator model. A PLATFORM user (Super Admin) never belongs to a
// company or holds a Role — companyId/roleId are nullable for exactly that
// case. A COMPANY user always has both.
enum UserType {
  PLATFORM
  COMPANY
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  fullName     String
  email        String   @unique
  mobile       String?
  passwordHash String
  isActive     Boolean  @default(true)
  userType     UserType @default(COMPANY)
  companyId    String?
  roleId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company                      Company?              @relation(fields: [companyId], references: [id])
  role                         Role?                 @relation(fields: [roleId], references: [id])
  sessions                     Session[]
  vouchers                     Voucher[]
  quotations                   Quotation[]
  salesOrders                  SalesOrder[]
  deliveryChallans             DeliveryChallan[]
  salesInvoices                SalesInvoice[]
  salesInvoiceItemOverrides    SalesInvoiceItem[]
  salesReturns                 SalesReturn[]
  creditNotes                  CreditNote[]
  debitNotes                   DebitNote[]
  purchaseOrders               PurchaseOrder[]
  goodsReceiptNotes            GoodsReceiptNote[]
  purchaseInvoices             PurchaseInvoice[]
  purchaseInvoiceItemOverrides PurchaseInvoiceItem[]

  @@index([companyId])
  @@index([roleId])
  @@index([userType])
}

// Roles are per-company (no shared/global rows) — every company gets its own
// private clone of the 6 reserved default roles, seeded by
// TenantBootstrapService at company-creation time. The pre-migration global
// roles were backfilled into per-company copies and every existing User's
// roleId was repointed (architecture-Migration-Super-Admin-Administration-
// Implementation-Plan.md's Phase 8) before this column became required.
//
// isSystemDefined: this is one of the 6 reserved default roles for its
// company (Company Admin/Accountant/Sales/Purchase/Store Manager/Employee).
// isProtected: rename/delete/deactivate/mandatory-permission protection is
// enforced for this row. Kept independent from isSystemDefined (rather than
// derived from it) so a future feature could protect a hand-created custom
// role without redefining what "system default" means — today every
// isSystemDefined role is seeded with isProtected: true and no custom role
// ever is.
model Role {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  name            String
  isSystemDefined Boolean  @default(false)
  isProtected     Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id        String   @id @default(uuid())
  module    String
  action    String
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

enum AccountNature {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
}

model LedgerGroup {
  id                 String        @id @default(uuid())
  companyId          String
  company            Company       @relation(fields: [companyId], references: [id])
  name               String
  parentGroupId      String?
  parentGroup        LedgerGroup?  @relation("LedgerGroupHierarchy", fields: [parentGroupId], references: [id])
  childGroups        LedgerGroup[] @relation("LedgerGroupHierarchy")
  natureType         AccountNature
  affectsGrossProfit Boolean       @default(false)
  isSystemDefined    Boolean       @default(false)
  isActive           Boolean       @default(true)
  remarks            String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  ledgers Ledger[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([parentGroupId])
}

enum BalanceType {
  DEBIT
  CREDIT
}

model Ledger {
  id                 String      @id @default(uuid())
  companyId          String
  company            Company     @relation(fields: [companyId], references: [id])
  ledgerGroupId      String
  ledgerGroup        LedgerGroup @relation(fields: [ledgerGroupId], references: [id])
  name               String
  openingBalance     Decimal     @default(0) @db.Decimal(14, 2)
  openingBalanceType BalanceType @default(DEBIT)
  description        String?
  isSystemDefined    Boolean     @default(false)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  bankAccount    BankAccount?
  customer       Customer?
  supplier       Supplier?
  voucherEntries VoucherEntry[]

  salesInvoicePayments              SalesInvoicePayment[]
  purchaseInvoicePayments           PurchaseInvoicePayment[]
  salesReturnsAsRefundLedger        SalesReturn[]            @relation("SalesReturnRefundLedger")
  creditNotesAsRefundLedger         CreditNote[]             @relation("CreditNoteRefundLedger")
  companySettingsAsSalesLedger      CompanySettings[]        @relation("CompanySettingsSalesLedger")
  companySettingsAsOutputCgstLedger CompanySettings[]        @relation("CompanySettingsOutputCgst")
  companySettingsAsOutputSgstLedger CompanySettings[]        @relation("CompanySettingsOutputSgst")
  companySettingsAsOutputIgstLedger CompanySettings[]        @relation("CompanySettingsOutputIgst")
  companySettingsAsOutputCessLedger CompanySettings[]        @relation("CompanySettingsOutputCess")
  companySettingsAsRoundOffLedger   CompanySettings[]        @relation("CompanySettingsRoundOff")
  companySettingsAsPurchaseLedger   CompanySettings[]        @relation("CompanySettingsPurchaseLedger")
  companySettingsAsInputCgstLedger  CompanySettings[]        @relation("CompanySettingsInputCgst")
  companySettingsAsInputSgstLedger  CompanySettings[]        @relation("CompanySettingsInputSgst")
  companySettingsAsInputIgstLedger  CompanySettings[]        @relation("CompanySettingsInputIgst")
  companySettingsAsInputCessLedger  CompanySettings[]        @relation("CompanySettingsInputCess")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([ledgerGroupId])
}

enum BankAccountType {
  SAVINGS
  CURRENT
  CASH_CREDIT
  OVERDRAFT
}

// A strict 1:1 extension of Ledger (ledgerId @unique) — the display name,
// opening balance, and active/inactive state live on the Ledger row;
// BankAccount only adds the fields a generic Ledger has no room for.
// companyId duplicates ledger.companyId (a deliberate denormalization
// matching every other model's direct companyId column in this codebase),
// kept in sync only because BankAccount and its Ledger are always created
// and updated together in the same transaction (15-bank-management.md),
// never independently.
model BankAccount {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  ledgerId          String          @unique
  ledger            Ledger          @relation(fields: [ledgerId], references: [id])
  bankName          String
  accountNumber     String
  ifscCode          String
  branchName        String
  accountHolderName String
  accountType       BankAccountType @default(CURRENT)
  upiId             String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([companyId, accountNumber])
  @@index([companyId])
}

// Unit of measure master (19-unit-management.md) — the first Inventory
// Masters table. `symbol` is the short form printed on documents ("PCS"),
// unique per company independently of `name` so two units can never print
// identically. `uqcCode` is the optional GST Unit Quantity Code GSTR-1's HSN
// summary needs per line — a plain optional string until the GST Engine
// (phase-tracker #31) formalizes it. No isSystemDefined and no seeding:
// unlike the chart of accounts, nothing structurally depends on any
// particular unit existing, so every unit is user-created.
model Unit {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  symbol        String
  uqcCode       String?
  decimalPlaces Int      @default(0)
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]

  @@unique([companyId, name])
  @@unique([companyId, symbol])
  @@index([companyId])
}

// Product classification tree (20-category-management.md) — the "Stock
// Group" concept Product Management (phase-tracker #23) will assign every
// product to. `name` is unique per company across the whole tree (not merely
// among siblings), matching LedgerGroup's rule and required for an
// unambiguous flat lookup in the Product form. Unlike LedgerGroup, the
// parent is editable after creation — a Category carries no inherited
// classification, so re-parenting only changes presentation/grouping; the
// service owns the resulting cycle-prevention obligation. No isSystemDefined
// and no seeding, for the same reason as Unit: nothing structurally depends
// on any particular category existing.
model Category {
  id               String     @id @default(uuid())
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id])
  name             String
  parentCategoryId String?
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories  Category[] @relation("CategoryHierarchy")
  description      String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  products         Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([parentCategoryId])
}

// Brand/manufacturer master (21-brand-management.md) — publishers in the
// book trade, paint manufacturers in the future formula-management vertical.
// The flat, company-scoped label Product Management (phase-tracker #23) will
// assign products to. No isSystemDefined and no seeding, same reasoning as
// Unit: nothing structurally depends on any particular brand existing. No
// hierarchy either — unlike Categories, brands have no grouping semantics
// anywhere in this ERP's plans (YAGNI).
model Brand {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

// HSN for goods, SAC for services (22-hsn-management.md) — the Product
// Architecture supports Trading Product / Service / Expense Item product
// types, so the master holds both code families from day one.
enum HsnCodeType {
  HSN
  SAC
}

// HSN/SAC code master (22-hsn-management.md) — the tax-classification codes
// Product Management (phase-tracker #23) will reference and the GST Engine
// (#31) / GSTR-1's HSN Summary (#57) will consume per invoice line. `code` is
// unique per company across BOTH code types (HSN and SAC ranges don't
// meaningfully collide, and one uniqueness rule keeps the lookup
// unambiguous). `description` is required — GSTR-1's HSN Summary reports a
// description per code line, and a bare number is meaningless in the Product
// form's picker. Company-scoped (not global) per the tenant-isolation rule,
// and no seeding of the official directory: each business maintains only the
// handful of codes it trades in, same reasoning as Unit. No default GST rate
// here — the GST Engine owns HSN→rate mapping, same deferral as Unit's
// uqcCode.
model HsnCode {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  code        String
  codeType    HsnCodeType @default(HSN)
  description String
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  products    Product[]

  @@unique([companyId, code])
  @@index([companyId])
}

// GST rate slab master (23-gst-rate-management.md) — the rate slabs Product
// Management (phase-tracker #23) will assign to products and the GST Engine
// (#31) will read to compute CGST/SGST/IGST and cess on documents. Stores
// only the TOTAL rate plus cess: the CGST+SGST/IGST split is pure arithmetic
// (half/half vs full) owned exclusively by the GST Engine, so storing the
// components would duplicate derivable data. `name` (not the numbers) is the
// display label pickers and documents show, unique per company; duplicate
// percentages under different names are deliberately allowed. Decimal(5,2)
// matches the codebase's Decimal-for-money/percentage convention
// (Ledger.openingBalance), and two decimals are required for the statutory
// 0.25% slab. No isSystemDefined and no seeding — slabs change by government
// notification and nothing depends structurally on any particular row
// existing, same reasoning as Unit.
model GstRate {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  name        String
  ratePercent Decimal   @db.Decimal(5, 2)
  cessPercent Decimal   @default(0) @db.Decimal(5, 2)
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Warehouse master (24-warehouse-management.md) — the physical stock
// locations (godowns/stores) Product Management (phase-tracker #23), the
// Inventory Engine (#30), Opening Stock (#44), and Stock Transfer (#46) will
// reference. `code` is the short identifier printed on stock documents
// (e.g. "WH-MAIN"), unique per company independently of `name`, mirroring
// Branch.branchCode and Unit's name/symbol pairing. `branchId` is optional
// because zero-branch companies are fully supported (12-branch-management.md
// rule); it ties the warehouse to a branch for future branch-wise stock
// reporting. `address` is a single free-text field — structured warehouse
// address deliberately deferred, same decision as Branch. `isDefault` — at
// most one per company — is service-enforced (Serializable transaction, not
// a DB constraint: Prisma's schema language cannot express a partial unique
// index portably; mirrors FinancialYear.isCurrent). No isSystemDefined and
// no seeding — nothing depends structurally on a warehouse row existing,
// same reasoning as Unit. No delete anywhere — Activate/Deactivate only.
model Warehouse {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  // Composite tenant-safe FK (review fix, 2026-07-18): relating
  // (companyId, branchId) → Branch(companyId, id) makes the DB itself reject
  // a cross-company branch link, as defense-in-depth behind the repository's
  // assertAssignableBranch check. MATCH SIMPLE semantics keep the branchless
  // (branchId NULL) case fully supported. Prisma emits ON DELETE RESTRICT
  // here (a required column is part of the FK) — fine, since branches are
  // never deleted anywhere in this codebase (Activate/Deactivate only).
  branchId      String?
  branch        Branch?  @relation(fields: [companyId, branchId], references: [companyId, id])
  name          String
  code          String
  address       String?
  contactNumber String?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products              Product[]
  stockTransactions     StockTransaction[]
  deliveryChallanItems  DeliveryChallanItem[]
  salesInvoiceItems     SalesInvoiceItem[]
  goodsReceiptNoteItems GoodsReceiptNoteItem[]
  purchaseInvoiceItems  PurchaseInvoiceItem[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
}

// Trading Product / Service / Expense Item per architecture-context.md's
// Product Architecture (25-product-management.md). FORMULA is deliberately
// NOT added — it is reserved for the future manufacturing release, and
// adding an enum value later is a trivial migration (YAGNI).
enum ProductType {
  TRADING
  SERVICE
  EXPENSE
}

// Product/item master (25-product-management.md) — the master every
// stock-bearing and billing feature (Sales #41, Purchase #42, Inventory
// Engine #30, Pricing Engine #28, Opening Stock #44, Barcode Billing #76)
// will reference. Master data ONLY: reference prices (mrp / sellingPrice /
// purchasePrice) are plain stored data — every derived price is the Pricing
// Engine's job and every quantity movement is the Inventory Engine's
// (architecture-context.md Invariants 6–7). `purchasePrice` is the
// manually-entered starting value for the "Latest Purchase Cost" costing
// strategy; the Purchase module (#42) will later overwrite it on each
// purchase. `productCode` is the required user-entered SKU (no
// auto-numbering — the Document Number Engine #32 owns numbering);
// `barcode` is optional and unique per company when present (Postgres
// composite unique treats NULLs as distinct, so many products may omit it) —
// stored now so Barcode Billing has data to build on. `unitId` is required
// for every type, including services (billed in Hours/Nos/Jobs); the other
// classification links are optional — not every business classifies every
// product, exempt/unregistered scenarios exist, and single-location shops
// may never create a warehouse. `minStockLevel` is Decimal(14,4) because
// quantities honor the unit's decimalPlaces (0–4). Once the Inventory
// Engine records movements for a product, `unitId` and `productType` must
// become immutable (changing them would silently re-denominate history) —
// nothing to check against yet. No isSystemDefined and no seeding, same
// reasoning as every Inventory Master since Unit. No delete anywhere —
// Activate/Deactivate only.
model Product {
  id                 String         @id @default(uuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id])
  name               String
  productCode        String
  barcode            String?
  productType        ProductType    @default(TRADING)
  categoryId         String?
  category           Category?      @relation(fields: [categoryId], references: [id])
  brandId            String?
  brand              Brand?         @relation(fields: [brandId], references: [id])
  unitId             String
  unit               Unit           @relation(fields: [unitId], references: [id])
  hsnCodeId          String?
  hsnCode            HsnCode?       @relation(fields: [hsnCodeId], references: [id])
  gstRateId          String?
  gstRate            GstRate?       @relation(fields: [gstRateId], references: [id])
  defaultWarehouseId String?
  defaultWarehouse   Warehouse?     @relation(fields: [defaultWarehouseId], references: [id])
  marginProfileId    String?
  marginProfile      MarginProfile? @relation(fields: [marginProfileId], references: [id])
  mrp                Decimal?       @db.Decimal(14, 2)
  sellingPrice       Decimal?       @db.Decimal(14, 2)
  purchasePrice      Decimal?       @db.Decimal(14, 2)
  minStockLevel      Decimal?       @db.Decimal(14, 4)
  description        String?
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  priceListItems        PriceListItem[]
  stockTransactions     StockTransaction[]
  quotationItems        QuotationItem[]
  salesOrderItems       SalesOrderItem[]
  deliveryChallanItems  DeliveryChallanItem[]
  salesInvoiceItems     SalesInvoiceItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  goodsReceiptNoteItems GoodsReceiptNoteItem[]
  purchaseInvoiceItems  PurchaseInvoiceItem[]

  @@unique([companyId, name])
  @@unique([companyId, productCode])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
  @@index([marginProfileId])
}

// Named, reusable percentage-based pricing rule (28-margin-profiles.md,
// PRD.md §12) the Pricing Engine (#28) will apply to a product's latest
// purchase cost to derive tier-wise selling prices. Stores data only — no
// price is calculated here or anywhere in this module
// (architecture-context.md Invariant 6, Engine Driven). One percentage per
// CustomerType tier, all four required — a company pricing every tier
// identically simply enters the same number four times. calculationMode is
// stored per profile (not per company) so mixed strategies are possible.
// Percentages are Decimal(5,2); the MARGIN-mode < 100 bound (the formula
// divides by 1 − p/100) and the MARKUP-mode ≤ 999.99 bound are enforced in
// Zod only (mode-dependent superRefine) — no DB CHECK, matching GstRate's
// convention. No isSystemDefined and no seeding, no rounding configuration,
// no category/brand-level defaults — all deliberately deferred (YAGNI). No
// delete anywhere — Activate/Deactivate only, same as every master since
// Units.
model MarginProfile {
  id                 String               @id @default(uuid())
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id])
  name               String
  calculationMode    PriceCalculationMode @default(MARGIN)
  retailPercent      Decimal              @db.Decimal(5, 2)
  wholesalePercent   Decimal              @db.Decimal(5, 2)
  dealerPercent      Decimal              @db.Decimal(5, 2)
  distributorPercent Decimal              @db.Decimal(5, 2)
  description        String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Named collection of fixed selling prices (29-price-lists.md, PRD.md §587)
// the Pricing Engine (#28) will consult BEFORE falling back to margin
// calculation. Pure master data — no price resolution (which list wins,
// quantity-break selection, date-window selection) lives here or anywhere in
// this module (architecture-context.md Invariant 6, Engine Driven).
// customerType null = tier-agnostic, applies to any customer the Pricing
// Engine routes to it. effectiveFrom/effectiveTo (both optional, inclusive
// calendar days) are the promotional-pricing primitive — a Diwali list is
// just a list with a window; overlapping windows across lists are legal by
// design, the Pricing Engine's resolution order decides among
// simultaneously-effective lists. No isSystemDefined and no seeding. No
// delete — Activate/Deactivate only, same as every master since Units.
model PriceList {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  name          String
  customerType  CustomerType?
  effectiveFrom DateTime?     @db.Date
  effectiveTo   DateTime?     @db.Date
  description   String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items     PriceListItem[]
  customers Customer[]

  @@unique([companyId, name])
  @@index([companyId])
}

// A price row within a PriceList — the quantity-pricing primitive:
// (priceListId, productId, minQuantity) unique means one product may carry
// several rows ("1+ -> price A, 10+ -> price B"); the Pricing Engine picks
// the highest break <= ordered quantity (not implemented here). Deliberately
// carries NO companyId — an item is reachable only through its parent list,
// every repository query joins through priceListId, and the parent's
// companyId is the single tenant anchor. Item rows ARE hard-deletable
// (unlike every other master's child data) — a detail line of an editable
// master, not a business record with history; nothing references a row, and
// Sales documents will snapshot the resolved price at posting time rather
// than referencing it (the HSN snapshot-at-posting precedent).
model PriceListItem {
  id           String    @id @default(uuid())
  priceListId  String
  priceList    PriceList @relation(fields: [priceListId], references: [id])
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  sellingPrice Decimal   @db.Decimal(14, 2)
  minQuantity  Decimal   @default(1) @db.Decimal(14, 4)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([priceListId, productId, minQuantity])
  @@index([priceListId])
  @@index([productId])
}

// The Pricing Engine's (#28) two company-choosable ways to derive a selling
// price from a product's latest purchase cost (PRD.md §12):
// MARKUP: sellingPrice = cost × (1 + percent / 100)
// MARGIN: sellingPrice = cost / (1 − percent / 100)
// Not implemented here — MarginProfile only stores the choice.
enum PriceCalculationMode {
  MARGIN
  MARKUP
}

// The pricing tier the Pricing Engine (#28) and Price Lists (#27) will key
// on (26-customer-management.md) — stored as plain data here, no pricing
// behavior attaches to it in the Customer master itself.
enum CustomerType {
  RETAIL
  WHOLESALE
  DEALER
  DISTRIBUTOR
}

// Permanent Customer master (26-customer-management.md) — a strict 1:1
// extension of Ledger (ledgerId @unique), exactly the BankAccount pattern
// with "Bank Accounts" swapped for "Sundry Debtors": the display name,
// opening balance/type, description, and active/inactive state live on the
// Ledger row; Customer only adds the party fields a generic Ledger has no
// room for. companyId duplicates ledger.companyId (the same deliberate
// denormalization as BankAccount), kept in sync only because the pair is
// always written together in one transaction, never independently. No
// customerCode — the customer's identity per company is the Ledger's name
// (@@unique([companyId, name]) already enforced); auto-numbered codes are
// the Document Number Engine's (#32) job. gstin is deliberately NOT unique:
// two customer records may legitimately share a GSTIN (two branches of the
// same registered buyer tracked as separate parties/ledgers). creditLimit/
// creditDays are plain stored data — enforcement is Sales Invoice (#36) /
// Voucher Engine (#29) territory. Quick and Walk-in customers get no row
// here by design (Sales Invoice #36 owns both). No isSystemDefined and no
// seeding — nothing structurally depends on any customer existing. No
// delete anywhere — Activate/Deactivate only.
model Customer {
  id              String       @id @default(uuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id])
  ledgerId        String       @unique
  ledger          Ledger       @relation(fields: [ledgerId], references: [id])
  customerType    CustomerType @default(RETAIL)
  contactPerson   String?
  mobileNumber    String?
  alternateMobile String?
  email           String?
  gstin           String?
  pan             String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  district        String?
  country         String       @default("India")
  pinCode         String?
  creditLimit     Decimal?     @db.Decimal(14, 2)
  creditDays      Int?
  priceListId     String?
  priceList       PriceList?   @relation(fields: [priceListId], references: [id])
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  quotations       Quotation[]
  salesOrders      SalesOrder[]
  deliveryChallans DeliveryChallan[]
  salesInvoices    SalesInvoice[]
  creditNotes      CreditNote[]
  debitNotes       DebitNote[]

  @@index([companyId])
  @@index([priceListId])
}

// Permanent Supplier master (27-supplier-management.md) — the credit-side
// mirror of Customer: a strict 1:1 extension of Ledger (ledgerId @unique)
// under "Sundry Creditors" instead of "Sundry Debtors". The display name,
// opening balance/type (defaulting to CREDIT for a creditor), description,
// and active/inactive state live on the Ledger row; Supplier only adds the
// party fields a generic Ledger has no room for. companyId duplicates
// ledger.companyId (the same deliberate denormalization as BankAccount/
// Customer), kept in sync only because the pair is always written together
// in one transaction, never independently. Two deliberate omissions versus
// Customer: no supplierType — the RETAIL/WHOLESALE/DEALER/DISTRIBUTOR tiers
// exist for the selling-side Pricing Engine and nothing prices purchases by
// supplier tier (YAGNI); and no creditLimit — a credit limit is a cap WE
// impose on a debtor, what a supplier extends to us is their decision, so
// storing it would be dead data. creditDays (agreed payment terms) is kept —
// Purchase Invoice (#42) and payables ageing will consume it. No
// supplierCode (Document Number Engine #32's job); gstin deliberately NOT
// unique (two branches of one registered vendor may share a GSTIN). No
// isSystemDefined and no seeding — nothing structurally depends on any
// supplier existing. No delete anywhere — Activate/Deactivate only.
model Supplier {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  ledgerId        String   @unique
  ledger          Ledger   @relation(fields: [ledgerId], references: [id])
  contactPerson   String?
  mobileNumber    String?
  alternateMobile String?
  email           String?
  gstin           String?
  pan             String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  district        String?
  country         String   @default("India")
  pinCode         String?
  creditDays      Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders    PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  purchaseInvoices  PurchaseInvoice[]

  @@index([companyId])
}

// Scoped narrowly to the Administration-side tenant-lifecycle events the
// Super Admin migration itself introduces (Company Created/Updated, Company
// Admin Created/Updated/Reassigned, Company Activated/Deactivated, Company
// Admin Password Reset/Activated/Deactivated), plus Bank Account
// Activated/Deactivated (bank-accounts module) — not a general audit-log
// retrofit across every existing module. That broader "Write Audit Log" gap
// remains separately tracked in architecture-context.md's Known
// Implementation Gaps.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([actorUserId])
  @@index([targetType, targetId])
}

model Session {
  id     String @id @default(uuid())
  userId String

  // Optional context per 07-authentication.md — Company/Branch/Financial Year
  // selection remain their own cookie-based mechanisms (current-company.ts,
  // current-financial-year.ts); these columns exist to match the spec's
  // session data shape but are not populated by this phase.
  companyId       String?
  branchId        String?
  financialYearId String?

  rememberMe Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Forward-declarative catalog covering every numbered document on the phase
// tracker (34-document-number-engine.md) — the Document Number Engine's
// contract, mirroring the DEFAULT_ROLE_PERMISSIONS precedent of listing
// entries for modules that don't exist yet. Every one of the Voucher
// Engine's (spec 31) ten VoucherTypes maps 1:1 to its own dedicated
// `*_VOUCHER` entry — a document and the voucher it generates are two
// separately numbered things.
enum DocumentType {
  QUOTATION
  SALES_ORDER
  DELIVERY_CHALLAN
  SALES_INVOICE
  SALES_RETURN
  CREDIT_NOTE
  DEBIT_NOTE
  PURCHASE_ORDER
  GOODS_RECEIPT_NOTE
  PURCHASE_INVOICE
  PURCHASE_RETURN
  PAYMENT_VOUCHER
  RECEIPT_VOUCHER
  CONTRA_VOUCHER
  JOURNAL_VOUCHER
  SALES_VOUCHER
  PURCHASE_VOUCHER
  CREDIT_NOTE_VOUCHER
  DEBIT_NOTE_VOUCHER
  SALES_RETURN_VOUCHER
  PURCHASE_RETURN_VOUCHER
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
}

// One row per (company, financial year, document type) — the sole owner of
// sequential document numbering (34-document-number-engine.md). Lazily
// created on first use (ensureSequence); no seeding. No branchId — Branch
// Management (spec 12) is unimplemented, and a nullable column inside a
// composite unique creates the Postgres NULLs-are-distinct trap; a future
// migration adds the dimension deliberately when branches land.
model DocumentSequence {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  documentType    DocumentType
  prefix          String
  padding         Int           @default(4)
  nextNumber      Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([companyId, financialYearId, documentType])
  @@index([companyId])
}

enum VoucherType {
  PAYMENT
  RECEIPT
  CONTRA
  JOURNAL
  SALES
  PURCHASE
  CREDIT_NOTE
  DEBIT_NOTE
  SALES_RETURN
  PURCHASE_RETURN
}

enum VoucherStatus {
  POSTED
  CANCELLED
}

// The double-entry accounting core (31-voucher-engine.md) — the single place
// ledger postings exist. Born POSTED (no draft status: the Document-Driven
// Draft->...->Posted lifecycle belongs to business documents, not vouchers)
// and immutable thereafter; cancellation creates a mirrored reversal instead
// of ever mutating a posted row. No `branchId` — Branch Management (spec 12)
// is unimplemented (same reasoning as DocumentSequence above).
model Voucher {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  voucherType     VoucherType
  voucherNumber   String
  voucherDate     DateTime      @db.Date
  status          VoucherStatus @default(POSTED)
  narration       String?
  // Polymorphic link to the source document ("SALES_INVOICE", its id) — no FK
  // by design: voucher rows must outlive any referencing table's shape, and
  // the source-document tables don't exist yet. Manual vouchers (#50-#53)
  // leave both null.
  referenceType   String?
  referenceId     String?
  // Sum of debit entries (== credit sum) — denormalized for list rendering
  // only, never used in balance computation (entries are the truth).
  totalAmount     Decimal       @db.Decimal(14, 2)
  // Self-relation, @unique: a voucher is reversed at most once. The reversal
  // voucher's entries mirror the original with DEBIT<->CREDIT swapped.
  reversalOfId    String?       @unique
  reversalOf      Voucher?      @relation("VoucherReversal", fields: [reversalOfId], references: [id])
  reversedBy      Voucher?      @relation("VoucherReversal")
  createdByUserId String?
  createdBy       User?         @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  entries         VoucherEntry[]
  salesInvoice    SalesInvoice?
  salesReturn     SalesReturn?
  creditNote      CreditNote?
  debitNote       DebitNote?
  purchaseInvoice PurchaseInvoice?

  @@unique([companyId, financialYearId, voucherType, voucherNumber])
  @@index([companyId, voucherDate])
  @@index([companyId, voucherType])
  @@index([referenceType, referenceId])
}

// No companyId here — reachable only through its Voucher; every query joins
// through Voucher (the spec-29 PriceListItem reasoning).
model VoucherEntry {
  id         String      @id @default(uuid())
  voucherId  String
  voucher    Voucher     @relation(fields: [voucherId], references: [id])
  ledgerId   String
  ledger     Ledger      @relation(fields: [ledgerId], references: [id])
  entryType  BalanceType
  amount     Decimal     @db.Decimal(14, 2)
  lineNumber Int

  @@unique([voucherId, lineNumber])
  @@index([ledgerId])
  @@index([voucherId])
}

// 32-inventory-engine.md — the Inventory Engine's own type/direction split,
// distinct from Voucher's BalanceType (DEBIT/CREDIT): stock movement is
// IN/OUT, always a positive quantity (current stock = Sigma IN - Sigma OUT,
// explicit over signed quantities).
enum StockTransactionType {
  OPENING_STOCK
  PURCHASE
  PURCHASE_RETURN
  SALES
  SALES_RETURN
  TRANSFER
  ADJUSTMENT
  PHYSICAL_VERIFICATION
}

enum StockDirection {
  IN
  OUT
}

// The single place stock movement exists (architecture-context.md Invariant
// 7; code-standards.md "Stock quantity must never be updated directly.
// Current stock is calculated from stock transactions") —
// 32-inventory-engine.md. No update/delete API exists anywhere for this
// model: corrections are opposite-direction ADJUSTMENT rows recorded by
// future screens (#45), mirroring VoucherEntry's immutability.
//
// No `financialYearId` — deliberate: stock is continuous across financial
// years (closing stock of one year IS opening stock of the next), unlike
// Voucher which is FY-scoped. `referenceType`/`referenceId` is a polymorphic
// source-document link with no FK, same reasoning as Voucher — source
// document tables (#36, #41, #42) don't exist yet. `transferGroupId` links
// one transfer's OUT and IN rows (exactly two rows sharing one value,
// written atomically by `transferStock`); null for every other type.
// `unitCost` is an optional snapshot (set by purchases/opening stock, null
// where meaningless) — stored data, NOT used for valuation today (Latest
// Purchase Cost reads `Product.purchasePrice` instead); kept for a future
// FIFO/Weighted-Average costing method that cannot be computed
// retroactively without per-movement cost history.
model StockTransaction {
  id              String               @id @default(uuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id])
  productId       String
  product         Product              @relation(fields: [productId], references: [id])
  warehouseId     String
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id])
  transactionType StockTransactionType
  direction       StockDirection
  quantity        Decimal              @db.Decimal(14, 4)
  unitCost        Decimal?             @db.Decimal(14, 2)
  transactionDate DateTime             @db.Date
  referenceType   String?
  referenceId     String?
  transferGroupId String?
  narration       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([companyId, productId, warehouseId])
  @@index([companyId, transactionDate])
  @@index([referenceType, referenceId])
  @@index([transferGroupId])
}

// Purchase Order (feature-spec 42) — the company's commitment to buy from a
// Supplier, first document of Phase 4's chain (Purchase Order -> Goods
// Receipt Note -> Purchase Invoice -> Purchase Return). The mirror of
// SalesOrder from the purchase side: no financial or stock effect at all (no
// Voucher, no stock movement, no reservation) — what it tracks is
// fulfillment from the supplier's side via `receivedQuantity`, maintained
// exclusively by Goods Receipt Note's posting flow (feature-spec 43) through
// `purchaseOrderService.applyReceipt`. Unlike SalesOrder, there is no
// Quotation-equivalent predecessor (no "Purchase Quotation"/RFQ concept in
// this phase's scope).
enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

// Quotation — the first, non-binding step of the Sales document chain
// (35-quotations.md; architecture-context.md Document Driven: Quotation ->
// Sales Order -> Delivery Challan -> Sales Invoice). A priced offer with no
// financial or stock effect: no Voucher, no stock movement, no GST register
// entry. Header totals are a denormalized snapshot, recomputed from `items`
// via the GST Engine's calculateDocument every time lines are saved while
// editable, and simply not recomputed once terminal (mirrors Voucher.
// totalAmount's "denormalized for list rendering only" convention).
//
// `salesOrders SalesOrder[]` below is feature-spec 36's back-relation,
// added by that spec's own migration (a purely additive change) together
// with "Convert to Sales Order" (Quotation.createFromQuotation's caller).
//
// No `branchId` — Branch Management (feature-spec 12) is implemented, but
// every document in this chain (specs 36-41) is drafted around this header
// shape without a branch dimension, and Voucher/DocumentSequence/
// StockTransaction are all still branch-less too; adding it only here would
// make Quotation the sole branch-aware document. Revisit as one deliberate
// cross-cutting migration later, not per-document.
enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Quotation {
  id                     String          @id @default(uuid())
  companyId              String
  company                Company         @relation(fields: [companyId], references: [id])
  financialYearId        String
  financialYear          FinancialYear   @relation(fields: [financialYearId], references: [id])
  quotationNumber        String
  quotationDate          DateTime        @db.Date
  validUntil             DateTime?       @db.Date
  customerId             String
  customer               Customer        @relation(fields: [customerId], references: [id])
  placeOfSupplyStateCode String
  status                 QuotationStatus @default(DRAFT)
  narration              String?
  subtotal               Decimal         @db.Decimal(14, 2)
  totalDiscount          Decimal         @db.Decimal(14, 2)
  taxableAmount          Decimal         @db.Decimal(14, 2)
  totalCgst              Decimal         @db.Decimal(14, 2)
  totalSgst              Decimal         @db.Decimal(14, 2)
  totalIgst              Decimal         @db.Decimal(14, 2)
  totalCess              Decimal         @db.Decimal(14, 2)
  grandTotal             Decimal         @db.Decimal(14, 2)
  createdByUserId        String?
  createdBy              User?           @relation(fields: [createdByUserId], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  items       QuotationItem[]
  salesOrders SalesOrder[]

  @@unique([companyId, financialYearId, quotationNumber])
  @@index([companyId, customerId])
  @@index([companyId, status])
}

model QuotationItem {
  id              String    @id @default(uuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id])
  lineNumber      Int
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  quantity        Decimal   @db.Decimal(14, 4)
  rate            Decimal   @db.Decimal(14, 2)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(14, 2)
  ratePercent     Decimal   @db.Decimal(5, 2)
  cessPercent     Decimal   @default(0) @db.Decimal(5, 2)
  taxableAmount   Decimal   @db.Decimal(14, 2)
  cgst            Decimal   @db.Decimal(14, 2)
  sgst            Decimal   @db.Decimal(14, 2)
  igst            Decimal   @db.Decimal(14, 2)
  cess            Decimal   @db.Decimal(14, 2)
  totalAmount     Decimal   @db.Decimal(14, 2)

  @@unique([quotationId, lineNumber])
  @@index([quotationId])
  @@index([productId])
}

// Sales Order — the second, binding step of the Sales document chain
// (36-sales-orders.md; architecture-context.md Document Driven: Quotation ->
// Sales Order -> Delivery Challan -> Sales Invoice). Like Quotation, has no
// financial or stock effect and no stock reservation (no such feature exists
// in the Inventory Engine) — what it adds over Quotation is fulfillment
// tracking via `SalesOrderItem.deliveredQuantity`, maintained exclusively by
// `salesOrderService.applyDelivery`, the entry point Delivery Challan
// (feature-spec 37) calls from its own posting flow.
//
// No `branchId` — see Quotation's identical note above; every document in
// this chain (specs 35-41) is drafted branch-less by deliberate, recorded
// scope decision.
enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id                     String              @id @default(uuid())
  companyId              String
  company                Company             @relation(fields: [companyId], references: [id])
  financialYearId        String
  financialYear          FinancialYear       @relation(fields: [financialYearId], references: [id])
  orderNumber            String
  orderDate              DateTime            @db.Date
  expectedDeliveryDate   DateTime?           @db.Date
  supplierId             String
  supplier               Supplier            @relation(fields: [supplierId], references: [id])
  placeOfSupplyStateCode String
  status                 PurchaseOrderStatus @default(DRAFT)
  narration              String?
  subtotal               Decimal             @db.Decimal(14, 2)
  totalDiscount          Decimal             @db.Decimal(14, 2)
  taxableAmount          Decimal             @db.Decimal(14, 2)
  totalCgst              Decimal             @db.Decimal(14, 2)
  totalSgst              Decimal             @db.Decimal(14, 2)
  totalIgst              Decimal             @db.Decimal(14, 2)
  totalCess              Decimal             @db.Decimal(14, 2)
  grandTotal             Decimal             @db.Decimal(14, 2)
  createdByUserId        String?
  createdBy              User?               @relation(fields: [createdByUserId], references: [id])
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  items             PurchaseOrderItem[]
  goodsReceiptNotes GoodsReceiptNote[]
  purchaseInvoices  PurchaseInvoice[]

  @@unique([companyId, financialYearId, orderNumber])
  @@index([companyId, supplierId])
  @@index([companyId, status])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  lineNumber       Int
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Decimal       @db.Decimal(14, 4)
  receivedQuantity Decimal       @default(0) @db.Decimal(14, 4)
  rate             Decimal       @db.Decimal(14, 2)
  discountPercent  Decimal       @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(14, 2)
  ratePercent      Decimal       @db.Decimal(5, 2)
  cessPercent      Decimal       @default(0) @db.Decimal(5, 2)
  taxableAmount    Decimal       @db.Decimal(14, 2)
  cgst             Decimal       @db.Decimal(14, 2)
  sgst             Decimal       @db.Decimal(14, 2)
  igst             Decimal       @db.Decimal(14, 2)
  cess             Decimal       @db.Decimal(14, 2)
  totalAmount      Decimal       @db.Decimal(14, 2)

  goodsReceiptNoteItems GoodsReceiptNoteItem[]

  @@unique([purchaseOrderId, lineNumber])
  @@index([productId])
}

// Goods Receipt Note (feature-spec 43) — the receiving/goods-inward record
// between a confirmed Purchase Order and the eventual Purchase Invoice
// (spec 44). Deliberately carries NO pricing or GST fields (same reasoning
// as Delivery Challan) and does NOT call the Inventory Engine — per the
// tracker's own Depends On column (Purchase Order only), stock only moves at
// Purchase Invoice posting time. `purchaseOrderId` is optional at the header
// (a GRN may be raised directly), but linkage is conditional per line: every
// line must carry a `purchaseOrderItemId` of that same order when set, and
// none may when it isn't — enforced in
// goods-receipt-note-schema.ts/goods-receipt-note-service.ts, not
// expressible as a schema-level constraint. `rejectedQuantity` is pure
// record-keeping in this task (see 43-goods-receipt-note.md's Data Model) —
// both `quantity` and `rejectedQuantity` count toward "received" for
// order-fulfillment purposes since the goods did physically arrive, but only
// `quantity` is ever billed (Purchase Invoice resolves its own cost
// independently).
enum GoodsReceiptNoteStatus {
  DRAFT
  RECEIVED
  INVOICED
  CANCELLED
}

model GoodsReceiptNote {
  id              String                 @id @default(uuid())
  companyId       String
  company         Company                @relation(fields: [companyId], references: [id])
  financialYearId String
  financialYear   FinancialYear          @relation(fields: [financialYearId], references: [id])
  grnNumber       String
  grnDate         DateTime               @db.Date
  supplierId      String
  supplier        Supplier               @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
  status          GoodsReceiptNoteStatus @default(DRAFT)
  narration       String?
  createdByUserId String?
  createdBy       User?                  @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  items           GoodsReceiptNoteItem[]
  purchaseInvoice PurchaseInvoice?

  @@unique([companyId, financialYearId, grnNumber])
  @@index([companyId, supplierId])
  @@index([companyId, status])
  @@index([purchaseOrderId])
}

model GoodsReceiptNoteItem {
  id                  String             @id @default(uuid())
  goodsReceiptNoteId  String
  goodsReceiptNote    GoodsReceiptNote   @relation(fields: [goodsReceiptNoteId], references: [id])
  lineNumber          Int
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  warehouseId         String
  warehouse           Warehouse          @relation(fields: [warehouseId], references: [id])
  quantity            Decimal            @db.Decimal(14, 4)
  rejectedQuantity    Decimal            @default(0) @db.Decimal(14, 4)
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@unique([goodsReceiptNoteId, lineNumber])
  @@index([productId])
  @@index([warehouseId])
  @@index([purchaseOrderItemId])
}

// Purchase Invoice (feature-spec 44) — the purchase-side mirror of
// SalesInvoice, first Purchase document with real financial (Voucher Engine,
// VoucherType.PURCHASE) and stock (Inventory Engine, StockTransactionType.
// PURCHASE/IN) consequences. Unlike SalesInvoice there is no
// customerMode-equivalent discriminator — every Purchase Invoice references
// an existing, active Supplier (no Quick/Walk-in concept for purchases).
// `invoiceNumber` is nullable and assigned only at posting time (a DRAFT row
// has no committed identity yet) — deliberately different from
// SalesInvoice.invoiceNumber, which is non-nullable and assigned at DRAFT
// creation; Postgres unique indexes treat NULL as distinct from NULL, so
// multiple DRAFT rows coexist under the same
// @@unique([companyId, financialYearId, invoiceNumber]) without collision.
// `supplierInvoiceNumber` (the supplier's own bill number) is the required,
// per-supplier-unique identifier a DRAFT row is looked up by instead.
enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

model PurchaseInvoice {
  id                     String                @id @default(uuid())
  companyId              String
  company                Company               @relation(fields: [companyId], references: [id])
  financialYearId        String
  financialYear          FinancialYear         @relation(fields: [financialYearId], references: [id])
  invoiceNumber          String?
  supplierInvoiceNumber  String
  invoiceDate            DateTime              @db.Date
  supplierId             String
  supplier               Supplier              @relation(fields: [supplierId], references: [id])
  placeOfSupplyStateCode String
  purchaseOrderId        String?
  purchaseOrder          PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptNoteId     String?               @unique
  goodsReceiptNote       GoodsReceiptNote?     @relation(fields: [goodsReceiptNoteId], references: [id])
  status                 PurchaseInvoiceStatus @default(DRAFT)
  narration              String?
  subtotal               Decimal               @db.Decimal(14, 2)
  totalDiscount          Decimal               @db.Decimal(14, 2)
  taxableAmount          Decimal               @db.Decimal(14, 2)
  totalCgst              Decimal               @db.Decimal(14, 2)
  totalSgst              Decimal               @db.Decimal(14, 2)
  totalIgst              Decimal               @db.Decimal(14, 2)
  totalCess              Decimal               @db.Decimal(14, 2)
  roundOff               Decimal               @default(0) @db.Decimal(14, 2)
  grandTotal             Decimal               @db.Decimal(14, 2)
  amountPaid             Decimal               @default(0) @db.Decimal(14, 2)
  voucherId              String?               @unique
  voucher                Voucher?              @relation(fields: [voucherId], references: [id])
  createdByUserId        String?
  createdBy              User?                 @relation(fields: [createdByUserId], references: [id])
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  items    PurchaseInvoiceItem[]
  payments PurchaseInvoicePayment[]

  @@unique([companyId, financialYearId, invoiceNumber])
  @@unique([companyId, supplierId, supplierInvoiceNumber])
  @@index([companyId, status])
  @@index([purchaseOrderId])
}

model PurchaseInvoiceItem {
  id                 String          @id @default(uuid())
  purchaseInvoiceId  String
  purchaseInvoice    PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  lineNumber         Int
  productId          String
  product            Product         @relation(fields: [productId], references: [id])
  warehouseId        String
  warehouse          Warehouse       @relation(fields: [warehouseId], references: [id])
  quantity           Decimal         @db.Decimal(14, 4)
  rate               Decimal         @db.Decimal(14, 2)
  discountPercent    Decimal         @default(0) @db.Decimal(5, 2)
  discountAmount     Decimal         @default(0) @db.Decimal(14, 2)
  ratePercent        Decimal         @db.Decimal(5, 2)
  cessPercent        Decimal         @default(0) @db.Decimal(5, 2)
  taxableAmount      Decimal         @db.Decimal(14, 2)
  cgst               Decimal         @db.Decimal(14, 2)
  sgst               Decimal         @db.Decimal(14, 2)
  igst               Decimal         @db.Decimal(14, 2)
  cess               Decimal         @db.Decimal(14, 2)
  totalAmount        Decimal         @db.Decimal(14, 2)
  isTaxOverridden    Boolean         @default(false)
  overriddenCgst     Decimal?        @db.Decimal(14, 2)
  overriddenSgst     Decimal?        @db.Decimal(14, 2)
  overriddenIgst     Decimal?        @db.Decimal(14, 2)
  overriddenCess     Decimal?        @db.Decimal(14, 2)
  overrideReason     String?
  overriddenByUserId String?
  overriddenBy       User?           @relation(fields: [overriddenByUserId], references: [id])

  @@unique([purchaseInvoiceId, lineNumber])
  @@index([productId])
  @@index([warehouseId])
}

// Cash/bank payment lines — restricted, server-side, to an active,
// company-owned ledger that is either under the seeded Cash-in-Hand ledger
// group or carries a BankAccount detail row (44-purchase-invoice.md's Ledger
// Posting rule) — stricter than SalesInvoicePayment's "any active company
// Ledger" convention, since paying out is a real cash/bank outflow.
model PurchaseInvoicePayment {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  ledgerId          String
  ledger            Ledger          @relation(fields: [ledgerId], references: [id])
  amount            Decimal         @db.Decimal(14, 2)
  reference         String?

  @@index([purchaseInvoiceId])
  @@index([ledgerId])
}

model SalesOrder {
  id                     String           @id @default(uuid())
  companyId              String
  company                Company          @relation(fields: [companyId], references: [id])
  financialYearId        String
  financialYear          FinancialYear    @relation(fields: [financialYearId], references: [id])
  orderNumber            String
  orderDate              DateTime         @db.Date
  expectedDeliveryDate   DateTime?        @db.Date
  customerId             String
  customer               Customer         @relation(fields: [customerId], references: [id])
  placeOfSupplyStateCode String
  status                 SalesOrderStatus @default(DRAFT)
  narration              String?
  quotationId            String?
  quotation              Quotation?       @relation(fields: [quotationId], references: [id])
  subtotal               Decimal          @db.Decimal(14, 2)
  totalDiscount          Decimal          @db.Decimal(14, 2)
  taxableAmount          Decimal          @db.Decimal(14, 2)
  totalCgst              Decimal          @db.Decimal(14, 2)
  totalSgst              Decimal          @db.Decimal(14, 2)
  totalIgst              Decimal          @db.Decimal(14, 2)
  totalCess              Decimal          @db.Decimal(14, 2)
  grandTotal             Decimal          @db.Decimal(14, 2)
  createdByUserId        String?
  createdBy              User?            @relation(fields: [createdByUserId], references: [id])
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  items            SalesOrderItem[]
  deliveryChallans DeliveryChallan[]
  salesInvoices    SalesInvoice[]

  @@unique([companyId, financialYearId, orderNumber])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([quotationId])
}

model SalesOrderItem {
  id                String     @id @default(uuid())
  salesOrderId      String
  salesOrder        SalesOrder @relation(fields: [salesOrderId], references: [id])
  lineNumber        Int
  productId         String
  product           Product    @relation(fields: [productId], references: [id])
  quantity          Decimal    @db.Decimal(14, 4)
  deliveredQuantity Decimal    @default(0) @db.Decimal(14, 4)
  rate              Decimal    @db.Decimal(14, 2)
  discountPercent   Decimal    @default(0) @db.Decimal(5, 2)
  discountAmount    Decimal    @default(0) @db.Decimal(14, 2)
  ratePercent       Decimal    @db.Decimal(5, 2)
  cessPercent       Decimal    @default(0) @db.Decimal(5, 2)
  taxableAmount     Decimal    @db.Decimal(14, 2)
  cgst              Decimal    @db.Decimal(14, 2)
  sgst              Decimal    @db.Decimal(14, 2)
  igst              Decimal    @db.Decimal(14, 2)
  cess              Decimal    @db.Decimal(14, 2)
  totalAmount       Decimal    @db.Decimal(14, 2)

  deliveryChallanItems DeliveryChallanItem[]

  @@unique([salesOrderId, lineNumber])
  @@index([salesOrderId])
  @@index([productId])
}

// Delivery Challan (feature-spec 37) — the dispatch/goods-movement record
// between a confirmed Sales Order and the eventual Sales Invoice (spec 38).
// Deliberately carries NO pricing or GST fields (quantity and source
// warehouse only) and does NOT call the Inventory Engine — per the tracker's
// own Depends On column, stock only moves at Sales Invoice posting time.
// `salesOrderId` is optional at the header (a challan may be raised
// directly), but linkage is conditional per line: every line must carry a
// `salesOrderItemId` of that same order when set, and none may when it
// isn't — enforced in delivery-challan-schema.ts/delivery-challan-service.ts,
// not expressible as a schema-level constraint.
enum DeliveryChallanStatus {
  DRAFT
  DISPATCHED
  INVOICED
  CANCELLED
}

model DeliveryChallan {
  id              String                @id @default(uuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id])
  financialYearId String
  financialYear   FinancialYear         @relation(fields: [financialYearId], references: [id])
  challanNumber   String
  challanDate     DateTime              @db.Date
  customerId      String
  customer        Customer              @relation(fields: [customerId], references: [id])
  salesOrderId    String?
  salesOrder      SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  status          DeliveryChallanStatus @default(DRAFT)
  narration       String?
  createdByUserId String?
  createdBy       User?                 @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  items        DeliveryChallanItem[]
  salesInvoice SalesInvoice?

  @@unique([companyId, financialYearId, challanNumber])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([salesOrderId])
}

model DeliveryChallanItem {
  id                String          @id @default(uuid())
  deliveryChallanId String
  deliveryChallan   DeliveryChallan @relation(fields: [deliveryChallanId], references: [id])
  lineNumber        Int
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  quantity          Decimal         @db.Decimal(14, 4)
  salesOrderItemId  String?
  salesOrderItem    SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])

  @@unique([deliveryChallanId, lineNumber])
  @@index([productId])
  @@index([warehouseId])
  @@index([salesOrderItemId])
}

// Sales Invoice (feature-spec 38) — the GST-compliant tax invoice that turns
// a sale into accounting entries (Voucher Engine), stock movement
// (Inventory Engine), and GST-correct totals (GST Engine), atomically, at
// posting time. The pivotal Phase 3 document: every document before it in
// this chain (Quotation, Sales Order, Delivery Challan) is display-only/
// non-stock-moving; this is the first real consumer of all three engines
// together. `voucherId` is `@unique` (one Voucher per invoice); `Voucher.
// referenceType`/`referenceId` (spec 31's polymorphic pair) also point back,
// belt-and-suspenders per this spec's Data Model decision.
enum SalesInvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

// PERMANENT requires customerId; QUICK requires quickCustomerName (mobile/
// GSTIN/address optional) and forbids customerId; WALK_IN forbids both
// customerId and every quickCustomer* field except an optional
// quickCustomerName for display only. Enforced in
// sales-invoice-schema.ts/sales-invoice-service.ts, not a DB constraint.
enum CustomerMode {
  PERMANENT
  QUICK
  WALK_IN
}

model SalesInvoice {
  id                     String             @id @default(uuid())
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id])
  financialYearId        String
  financialYear          FinancialYear      @relation(fields: [financialYearId], references: [id])
  invoiceNumber          String
  invoiceDate            DateTime           @db.Date
  customerMode           CustomerMode
  customerId             String?
  customer               Customer?          @relation(fields: [customerId], references: [id])
  quickCustomerName      String?
  quickCustomerMobile    String?
  quickCustomerGstin     String?
  quickCustomerAddress   String?
  placeOfSupplyStateCode String
  salesOrderId           String?
  salesOrder             SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  deliveryChallanId      String?            @unique
  deliveryChallan        DeliveryChallan?   @relation(fields: [deliveryChallanId], references: [id])
  status                 SalesInvoiceStatus @default(DRAFT)
  narration              String?
  subtotal               Decimal            @db.Decimal(14, 2)
  totalDiscount          Decimal            @db.Decimal(14, 2)
  taxableAmount          Decimal            @db.Decimal(14, 2)
  totalCgst              Decimal            @db.Decimal(14, 2)
  totalSgst              Decimal            @db.Decimal(14, 2)
  totalIgst              Decimal            @db.Decimal(14, 2)
  totalCess              Decimal            @db.Decimal(14, 2)
  roundOff               Decimal            @default(0) @db.Decimal(14, 2)
  grandTotal             Decimal            @db.Decimal(14, 2)
  amountPaid             Decimal            @default(0) @db.Decimal(14, 2)
  voucherId              String?            @unique
  voucher                Voucher?           @relation(fields: [voucherId], references: [id])
  createdByUserId        String?
  createdBy              User?              @relation(fields: [createdByUserId], references: [id])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  items        SalesInvoiceItem[]
  payments     SalesInvoicePayment[]
  salesReturns SalesReturn[]
  creditNotes  CreditNote[]
  debitNotes   DebitNote[]

  @@unique([companyId, financialYearId, invoiceNumber])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([salesOrderId])
}

model SalesInvoiceItem {
  id                 String       @id @default(uuid())
  salesInvoiceId     String
  salesInvoice       SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  lineNumber         Int
  productId          String
  product            Product      @relation(fields: [productId], references: [id])
  warehouseId        String
  warehouse          Warehouse    @relation(fields: [warehouseId], references: [id])
  quantity           Decimal      @db.Decimal(14, 4)
  rate               Decimal      @db.Decimal(14, 2)
  discountPercent    Decimal      @default(0) @db.Decimal(5, 2)
  discountAmount     Decimal      @default(0) @db.Decimal(14, 2)
  ratePercent        Decimal      @db.Decimal(5, 2)
  cessPercent        Decimal      @default(0) @db.Decimal(5, 2)
  taxableAmount      Decimal      @db.Decimal(14, 2)
  cgst               Decimal      @db.Decimal(14, 2)
  sgst               Decimal      @db.Decimal(14, 2)
  igst               Decimal      @db.Decimal(14, 2)
  cess               Decimal      @db.Decimal(14, 2)
  totalAmount        Decimal      @db.Decimal(14, 2)
  // The spec-33 forward-note, implemented literally: cgst/sgst/igst/cess
  // above always hold the SYSTEM-COMPUTED values (never overwritten);
  // overridden* holds the USED values only when isTaxOverridden is true,
  // alongside a required overrideReason — both remain readable forever
  // (the audit trail). The posted voucher uses overridden* when present.
  isTaxOverridden    Boolean      @default(false)
  overriddenCgst     Decimal?     @db.Decimal(14, 2)
  overriddenSgst     Decimal?     @db.Decimal(14, 2)
  overriddenIgst     Decimal?     @db.Decimal(14, 2)
  overriddenCess     Decimal?     @db.Decimal(14, 2)
  overrideReason     String?
  overriddenByUserId String?
  overriddenBy       User?        @relation(fields: [overriddenByUserId], references: [id])

  salesReturnItems SalesReturnItem[]

  @@unique([salesInvoiceId, lineNumber])
  @@index([productId])
  @@index([warehouseId])
}

// Cash/bank payment lines — ledgerId references any active company Ledger
// directly (typically "Cash-in-Hand" or a BankAccount-linked Ledger), no new
// Company Settings mapping needed (chosen explicitly per payment line, like
// every other transaction in this codebase picks its own ledgers).
model SalesInvoicePayment {
  id             String       @id @default(uuid())
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  ledgerId       String
  ledger         Ledger       @relation(fields: [ledgerId], references: [id])
  amount         Decimal      @db.Decimal(14, 2)
  reference      String?

  @@index([salesInvoiceId])
  @@index([ledgerId])
}

// 39-sales-return.md — the physical, quantity-based reversal of a posted
// Sales Invoice: goods come back into stock (StockTransactionType.
// SALES_RETURN, direction IN) and the customer's liability decreases
// (VoucherType.SALES_RETURN). Distinct from Credit Note (spec 40, pure
// financial, no stock) and Debit Note (spec 41) — see that spec's Goal
// section for the full three-way split. No independent product/rate entry:
// every line references a SalesInvoiceItem directly and derives its
// rate/tax from it (the overridden values when the source line was
// overridden) — only quantity is entered.
enum SalesReturnStatus {
  DRAFT
  POSTED
  CANCELLED
}

// LEDGER_ADJUSTMENT (default): reduces the customer's outstanding ledger
// balance, no cash moves — the common PERMANENT/converted-QUICK case.
// CASH_REFUND: cash/bank actually leaves the business, requiring
// refundLedgerId. A WALK_IN-sourced invoice has no customer ledger, so its
// returns are forced to CASH_REFUND regardless of this column's default
// (enforced in sales-return-service.ts, not a DB constraint).
enum RefundMode {
  LEDGER_ADJUSTMENT
  CASH_REFUND
}

model SalesReturn {
  id              String            @id @default(uuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  financialYearId String
  financialYear   FinancialYear     @relation(fields: [financialYearId], references: [id])
  // Nullable, assigned only at postSalesReturn (39-sales-return.md's
  // Decisions) — a DRAFT row has no committed identity yet. Postgres unique
  // indexes treat NULL as distinct, so multiple DRAFT rows coexist safely
  // under the @@unique below.
  returnNumber    String?
  returnDate      DateTime          @db.Date
  salesInvoiceId  String
  salesInvoice    SalesInvoice      @relation(fields: [salesInvoiceId], references: [id])
  refundMode      RefundMode        @default(LEDGER_ADJUSTMENT)
  refundLedgerId  String?
  refundLedger    Ledger?           @relation("SalesReturnRefundLedger", fields: [refundLedgerId], references: [id])
  status          SalesReturnStatus @default(DRAFT)
  reason          String?
  taxableAmount   Decimal           @db.Decimal(14, 2)
  totalCgst       Decimal           @db.Decimal(14, 2)
  totalSgst       Decimal           @db.Decimal(14, 2)
  totalIgst       Decimal           @db.Decimal(14, 2)
  totalCess       Decimal           @db.Decimal(14, 2)
  grandTotal      Decimal           @db.Decimal(14, 2)
  voucherId       String?           @unique
  voucher         Voucher?          @relation(fields: [voucherId], references: [id])
  createdByUserId String?
  createdBy       User?             @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  items SalesReturnItem[]

  @@unique([companyId, financialYearId, returnNumber])
  @@index([companyId, salesInvoiceId])
  @@index([companyId, status])
}

model SalesReturnItem {
  id                 String           @id @default(uuid())
  salesReturnId      String
  salesReturn        SalesReturn      @relation(fields: [salesReturnId], references: [id])
  lineNumber         Int
  salesInvoiceItemId String
  salesInvoiceItem   SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id])
  quantity           Decimal          @db.Decimal(14, 4)
  taxableAmount      Decimal          @db.Decimal(14, 2)
  cgst               Decimal          @db.Decimal(14, 2)
  sgst               Decimal          @db.Decimal(14, 2)
  igst               Decimal          @db.Decimal(14, 2)
  cess               Decimal          @db.Decimal(14, 2)
  totalAmount        Decimal          @db.Decimal(14, 2)

  // Prevents the same invoice line from being listed twice within one
  // return — a business returning more of the same line increases that
  // one line's quantity, never adds a second row for the same
  // salesInvoiceItemId (39-sales-return.md's Decisions).
  @@unique([salesReturnId, lineNumber])
  @@unique([salesReturnId, salesInvoiceItemId])
  @@index([salesInvoiceItemId])
}

// 40-credit-note.md — a PURE FINANCIAL adjustment reducing what a customer
// owes, with NO stock movement (price correction, post-invoice discount,
// rate dispute, or the optional GST-document-labeled complement to a return
// SalesReturn already posted on its own). Distinct from SalesReturn (always
// quantity/stock-based) and Debit Note (spec 41, the mirror increasing what
// a customer owes). Lines are freeform (description + taxableAmount +
// ratePercent/cessPercent), not derived from a product or invoice line —
// deliberately looser than SalesReturnItem's invoice-anchored shape, since a
// Credit Note's purpose is adjustments that don't map onto "N units of
// product X".
enum CreditNoteStatus {
  DRAFT
  POSTED
  CANCELLED
}

model CreditNote {
  id                     String           @id @default(uuid())
  companyId              String
  company                Company          @relation(fields: [companyId], references: [id])
  financialYearId        String
  financialYear          FinancialYear    @relation(fields: [financialYearId], references: [id])
  // Nullable, assigned only at postCreditNote — mirrors SalesReturn's own
  // returnNumber lifecycle (40-credit-note.md's Business Rules).
  noteNumber             String?
  noteDate               DateTime         @db.Date
  // Always required — a Credit Note always adjusts a specific customer's
  // liability, unlike salesInvoiceId (optional: a discount can cover an
  // account's overall history, not one particular invoice).
  customerId             String
  customer               Customer         @relation(fields: [customerId], references: [id])
  salesInvoiceId         String?
  salesInvoice           SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  placeOfSupplyStateCode String
  // Reuses SalesReturn's RefundMode enum and identical conditional-
  // refundLedgerId rule — a Credit Note may reduce the customer's ledger
  // balance or trigger an actual cash refund, for the same reason.
  refundMode             RefundMode       @default(LEDGER_ADJUSTMENT)
  refundLedgerId         String?
  refundLedger           Ledger?          @relation("CreditNoteRefundLedger", fields: [refundLedgerId], references: [id])
  status                 CreditNoteStatus @default(DRAFT)
  // Required (unlike SalesReturn's optional reason) — a Credit Note with no
  // linked invoice has no other context explaining why it exists.
  reason                 String
  taxableAmount          Decimal          @db.Decimal(14, 2)
  totalCgst              Decimal          @db.Decimal(14, 2)
  totalSgst              Decimal          @db.Decimal(14, 2)
  totalIgst              Decimal          @db.Decimal(14, 2)
  totalCess              Decimal          @db.Decimal(14, 2)
  grandTotal             Decimal          @db.Decimal(14, 2)
  voucherId              String?          @unique
  voucher                Voucher?         @relation(fields: [voucherId], references: [id])
  createdByUserId        String?
  createdBy              User?            @relation(fields: [createdByUserId], references: [id])
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  items CreditNoteItem[]

  @@unique([companyId, financialYearId, noteNumber])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([salesInvoiceId])
}

model CreditNoteItem {
  id            String     @id @default(uuid())
  creditNoteId  String
  creditNote    CreditNote @relation(fields: [creditNoteId], references: [id])
  lineNumber    Int
  description   String
  taxableAmount Decimal    @db.Decimal(14, 2)
  ratePercent   Decimal    @db.Decimal(5, 2)
  cessPercent   Decimal    @default(0) @db.Decimal(5, 2)
  cgst          Decimal    @db.Decimal(14, 2)
  sgst          Decimal    @db.Decimal(14, 2)
  igst          Decimal    @db.Decimal(14, 2)
  cess          Decimal    @db.Decimal(14, 2)
  totalAmount   Decimal    @db.Decimal(14, 2)

  @@unique([creditNoteId, lineNumber])
}

// 41-debit-note.md — the mirror of CreditNote: a PURE FINANCIAL adjustment
// that INCREASES what a customer owes, with NO stock movement (under-billing
// correction, additional post-invoice charges, interest/late-fee assessment).
// Identical shape to CreditNote except: no refundMode/refundLedgerId (a
// Debit Note only ever increases the customer's ledger balance — there is no
// cash-leaving-the-business direction to model).
enum DebitNoteStatus {
  DRAFT
  POSTED
  CANCELLED
}

model DebitNote {
  id                     String          @id @default(uuid())
  companyId              String
  company                Company         @relation(fields: [companyId], references: [id])
  financialYearId        String
  financialYear          FinancialYear   @relation(fields: [financialYearId], references: [id])
  // Nullable, assigned only at postDebitNote — mirrors CreditNote's own
  // noteNumber lifecycle.
  noteNumber             String?
  noteDate               DateTime        @db.Date
  customerId             String
  customer               Customer        @relation(fields: [customerId], references: [id])
  salesInvoiceId         String?
  salesInvoice           SalesInvoice?   @relation(fields: [salesInvoiceId], references: [id])
  placeOfSupplyStateCode String
  status                 DebitNoteStatus @default(DRAFT)
  reason                 String
  taxableAmount          Decimal         @db.Decimal(14, 2)
  totalCgst              Decimal         @db.Decimal(14, 2)
  totalSgst              Decimal         @db.Decimal(14, 2)
  totalIgst              Decimal         @db.Decimal(14, 2)
  totalCess              Decimal         @db.Decimal(14, 2)
  grandTotal             Decimal         @db.Decimal(14, 2)
  voucherId              String?         @unique
  voucher                Voucher?        @relation(fields: [voucherId], references: [id])
  createdByUserId        String?
  createdBy              User?           @relation(fields: [createdByUserId], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  items DebitNoteItem[]

  @@unique([companyId, financialYearId, noteNumber])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([salesInvoiceId])
}

model DebitNoteItem {
  id            String    @id @default(uuid())
  debitNoteId   String
  debitNote     DebitNote @relation(fields: [debitNoteId], references: [id])
  lineNumber    Int
  description   String
  taxableAmount Decimal   @db.Decimal(14, 2)
  ratePercent   Decimal   @db.Decimal(5, 2)
  cessPercent   Decimal   @default(0) @db.Decimal(5, 2)
  cgst          Decimal   @db.Decimal(14, 2)
  sgst          Decimal   @db.Decimal(14, 2)
  igst          Decimal   @db.Decimal(14, 2)
  cess          Decimal   @db.Decimal(14, 2)
  totalAmount   Decimal   @db.Decimal(14, 2)

  @@unique([debitNoteId, lineNumber])
}
