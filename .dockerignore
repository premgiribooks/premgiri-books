# dependencies (installed fresh inside the image for the correct platform)
node_modules
**/node_modules

# next.js build output
.next
out

# electron build output (not used by the containerized dev server)
dist-electron

# version control
.git
.gitignore

# env files (pass secrets via docker-compose env_file / environment instead)
.env
.env.*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editor / os
.vscode
.idea
.DS_Store

# test/build artifacts
coverage
*.tsbuildinfo

# docs (not needed at runtime)
docs
README.md
