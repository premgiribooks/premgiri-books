{
  "name": "premgir-books-v2",
  "version": "1.0.6",
  "private": true,
  "description": "Modular offline-first ERP for accounting, GST, inventory, and billing.",
  "author": {
    "name": "Premgiri Books ERP",
    "email": "premgiribooks@users.noreply.github.com"
  },
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/premgiribooks/premgiri-books.git"
  },
  "scripts": {
    "dev": "concurrently -k -n next,electron \"pnpm:dev:next\" \"pnpm:dev:electron\"",
    "dev:next": "next dev",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "build": "next build && node scripts/prepare-standalone.mjs && node scripts/build-electron.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:dir": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "release": "pnpm build && electron-builder --publish always"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.2",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.premgiribooks.books-erp",
    "productName": "Premgiri Books ERP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": ["**/*", "!.env", "!.env.*", "!**/.env"]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": ["**/*"]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "premgiribooks",
      "repo": "premgiri-books"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}