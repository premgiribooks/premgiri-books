# Copy this file to `.env.production` on the VPS (never commit the real
# file — .gitignore already excludes .env*) and fill in real values. Loaded
# by docker-compose.prod.yml's `app` service via `env_file`.

# Points at the LAN Postgres instance (192.168.1.39), reachable from this
# VPS specifically per docs/web-deployment.md's firewall/port-forwarding
# steps — not a fresh database. Prefer `sslmode=require` once TLS is
# configured on that Postgres server (strongly recommended: without it,
# every query's credentials and data cross the public internet in
# cleartext between this VPS and the LAN database).
DATABASE_URL="postgresql://premgiri_books:<password>@<public-ip-or-hostname-for-192.168.1.39>:5432/premgiribooks?schema=public&sslmode=require"

APP_NAME="Premgiri Books ERP"
APP_VERSION="1.0.13"
NODE_ENV="production"

# Passwords for the bootstrap "admin" (Company Admin) and "superadmin"
# (Platform) users created by `pnpm prisma db seed` — production enforces
# these being set (prisma/seed.ts throws instead of falling back when
# NODE_ENV=production and either is unset). Set strong, unique values.
SEED_ADMIN_PASSWORD=""
SEED_SUPER_ADMIN_PASSWORD=""

# Optional — defaults to ./backups (relative to the container's /app
# workdir) if unset. Only change this if you've mounted backups somewhere
# else in docker-compose.prod.yml.
# BACKUP_DIR="/app/backups"
